# Copy to .env.local and fill in your values. Never commit the real file.

# Supabase project used by the CRM (see docs/crm-setup.md).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Set only on the CRM deployment, to the CRM's own hostname.
# Leave unset on the public website deployment.
CRM_HOST=

# Set to "true" to expose /crm/demo outside development.
CRM_ENABLE_DEMO=

# Optional: email notification when a new website enquiry is captured.
# Leave either unset to disable notifications entirely.
RESEND_API_KEY=
CRM_NOTIFY_EMAIL=
# Optional. Defaults to Resend's unverified sandbox sender, which only
# delivers to the Resend account's own verified address. Set this to a
# "Name <you@yourdomain.com>" address on a domain verified in Resend
# once you're ready to receive notifications at any address.
CRM_NOTIFY_FROM=

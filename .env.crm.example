# Copy to .env.local and fill in your values. Never commit the real file.

# Supabase project used by the CRM (see docs/crm-setup.md).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Set only on the CRM deployment, to the CRM's own hostname.
# Leave unset on the public website deployment.
CRM_HOST=

# Set to "true" to expose /crm/demo outside development.
CRM_ENABLE_DEMO=

# Optional: email notification when a new website enquiry is captured.
# Leave either unset to disable notifications entirely.
RESEND_API_KEY=
CRM_NOTIFY_EMAIL=
# Optional. Defaults to Resend's unverified sandbox sender, which only
# delivers to the Resend account's own verified address. Set this to a
# "Name <you@yourdomain.com>" address on a domain verified in Resend
# once you're ready to receive notifications at any address.
CRM_NOTIFY_FROM=

# Receive-only WhatsApp webhook. Leave disabled until the new migration and number mapping are ready.
WHATSAPP_WEBHOOK_ENABLED=false
# Meta app secret (server-only); not a WhatsApp access token.
WHATSAPP_APP_SECRET=
# Generate your own random verification token; enter the same value in Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=

# Reviewed outbound replies. Disabled until migration, scoped credentials and messaging allowance are ready.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SEND_ORGANIZATION_ID=
WHATSAPP_SEND_PHONE_ID=
WHATSAPP_SEND_WABA_ID=
# Conservative all-in cost per reply, in INR paise; review against provider billing.
WHATSAPP_REPLY_COST_PAISE=

# AI drafts remain disabled until provider, model rates and a paid usage period are configured.
CRM_AI_ENABLED=false
# Automatic replies require this worker switch AND an admin's explicit workspace opt-in.
CRM_AUTO_REPLIES_ENABLED=false
# Random server-only secret of at least 32 characters. Never put in a browser variable.
CRM_WORKER_SECRET=
# Persistent worker's target (Vercel production origin). Local default: http://127.0.0.1:3001.
CRM_WORKER_BASE_URL=
# Meta Embedded Signup. Server returns only app/config IDs to the browser.
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# Separate 32-byte random hex key for encrypted customer WhatsApp tokens. Back it up.
CRM_WHATSAPP_TOKEN_KEY=
CRM_AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Groq strict structured-output model; provider and model can be changed later.
CRM_AI_MODEL=openai/gpt-oss-120b
# Conservative budget estimates in INR paise per million tokens; review against billing.
# Track estimated service cost even while using a free tier.
CRM_AI_INPUT_PAISE_PER_MILLION=2000
CRM_AI_OUTPUT_PAISE_PER_MILLION=8000

# Razorpay subscription billing. Leave disabled until the billing migration, Plan objects,
# webhook secret and per-plan allowances below are all configured. See docs/crm-billing-rollout.md.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_SECRET=
# From the Razorpay webhook settings page, not the API key secret.
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Plan ids, one per plan x billing-period combination. Each Plan's per-cycle amount
# must equal the full discounted total for that period (planPrice in src/lib/crm/plans.ts),
# not a monthly amount, since quarterly/annual billing is one upfront charge, not three/twelve.
RAZORPAY_PLAN_PRO_1=
RAZORPAY_PLAN_PRO_3=
RAZORPAY_PLAN_PRO_12=
RAZORPAY_PLAN_PRO_PLUS_1=
RAZORPAY_PLAN_PRO_PLUS_3=
RAZORPAY_PLAN_PRO_PLUS_12=
# Monthly INR 500 / 50000 paise plan, interval 1. Quantity is number of extra seats.
RAZORPAY_PLAN_EXTRA_SEAT=
# Operator-reviewed monthly overhead and allowances per plan, applied when a charge opens a
# usage period. Never invented: missing or non-positive values fail closed. Review against
# actual measured costs, matching docs/crm-usage-rollout.md's 70% cost ceiling.
CRM_OVERHEAD_PRO_PAISE=
CRM_AI_ALLOWANCE_PRO=
CRM_WHATSAPP_ALLOWANCE_PRO=
CRM_OVERHEAD_PRO_PLUS_PAISE=
CRM_AI_ALLOWANCE_PRO_PLUS=
CRM_WHATSAPP_ALLOWANCE_PRO_PLUS=

# Automated email follow-ups for leads whose follow-up date has passed with no reply.
# Requires this worker switch AND an admin's explicit workspace opt-in (Settings > Automatic
# follow-ups). Uses the same CRM_WORKER_SECRET/CRM_WORKER_BASE_URL as auto-replies above.
# SMS support was removed for now (pending DLT registration); the migration's schema for it
# stays in place, unused, so it can be re-added later without another migration.
CRM_FOLLOWUPS_ENABLED=false

# Email channel via Resend (same account/key as the notification email above, different
# purpose: this is the customer-facing sender identity for follow-up emails).
EMAIL_SEND_ENABLED=false
# "Name <you@yourdomain.com>" on a domain verified in Resend. The sandbox sender only
# delivers to the Resend account's own address, so this must be a verified domain to reach leads.
CRM_FOLLOWUP_FROM_EMAIL=
# Nominal cost per email, in INR paise (Resend's free tier is 3,000/month, 100/day).
EMAIL_REPLY_COST_PAISE=1

# Pro Plus scheduler: agents connect their own Google Calendar. Requires a Google Cloud
# project with the Calendar API enabled and an OAuth client (Web application) whose redirect
# URI is https://YOUR-CRM-HOST/api/crm/calendar/callback. See docs/crm-calendar-rollout.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# 32 random bytes, hex-encoded. Encrypts stored calendar refresh tokens; losing this key
# makes every stored connection unusable and every agent must reconnect.
CRM_CALENDAR_TOKEN_KEY=
